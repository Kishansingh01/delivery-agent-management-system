generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DeliveryAgent {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String
  serviceArea String
  status      String   @default("active") // "active" | "inactive" | "on_delivery"
  vehicleType String   @default("Motorcycle") // "Bicycle" | "Motorcycle" | "Car" | "Van"
  rating      Float    @default(5.0)
  activeOrders Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([serviceArea])
}
